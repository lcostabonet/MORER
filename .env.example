# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=
APP_URL=
WEB_URL=
ADMIN_URL=
# URL base de apps/api. Requerida por apps/web en producción.
# Desarrollo: http://localhost:4000
# Producción: https://tu-dominio-api
API_URL=

# ─── PostgreSQL (Docker local) ────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Desarrollo local: postgresql://user:password@localhost:5432/morer_dev
# Supabase (staging/prod): usar la URL del connection pooler (puerto 6543)
DATABASE_URL=

# DIRECT_URL es necesario para migraciones Prisma con Supabase (conexión directa, puerto 5432).
# En desarrollo local puedes usar el mismo valor que DATABASE_URL.
DIRECT_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=
REDIS_URL=

# ─── Supabase (staging/producción) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY tiene acceso completo a la base de datos.
# Nunca debe usarse en el frontend ni exponerse en el cliente.
# Solo para uso exclusivo en el backend (apps/api).
SUPABASE_SERVICE_ROLE_KEY=

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=
# En producción, GET /health/database devuelve 404 por defecto.
# Ponlo a "true" solo en entornos internos o con acceso controlado.
EXPOSE_DATABASE_HEALTH=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_EMAIL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=
RESEND_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
