# ─── General ─────────────────────────────────────────────────────────────────
NODE_ENV=
APP_URL=
# URL de apps/web — usada por apps/api para configurar CORS (Access-Control-Allow-Origin).
# Desarrollo: http://localhost:3000
WEB_URL=
# Phase 11J (R2) — number of trusted proxy hops in front of the API so Express
# resolves the real client IP for rate limiting. UNSET/false = trust nothing (safe
# default; X-Forwarded-For ignored). Railway edge in front of the API: set to 1.
TRUST_PROXY=
ADMIN_URL=
# Phase 11J — signing secret for ADMIN JWTs (admin login → back-office/ops actions
# such as POST /fulfillment/orders/:id/ship). MUST be different from JWT_SECRET so
# customer and admin tokens are cryptographically isolated. Long random value; if
# unset, AdminModule fails to start (admin auth is unavailable).
ADMIN_JWT_SECRET=
# URL base de apps/api (server-side). Requerida por apps/web en producción.
# Desarrollo: http://localhost:4000
# Producción (Railway internal): http://api.railway.internal:4000
API_URL=http://api.railway.internal:4000
# URL base de apps/api accesible desde el navegador (client-side, carrito).
# Mismo valor que API_URL en la mayoría de entornos.
NEXT_PUBLIC_API_URL=

# ─── PostgreSQL (Docker local) ────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Desarrollo local: postgresql://user:password@localhost:5432/morer_dev
# Supabase (staging/prod): usar la URL del connection pooler (puerto 6543)
DATABASE_URL=

# DIRECT_URL es necesario para migraciones Prisma con Supabase (conexión directa, puerto 5432).
# En desarrollo local puedes usar el mismo valor que DATABASE_URL.
DIRECT_URL=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=
REDIS_URL=

# ─── Supabase (staging/producción) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# IMPORTANTE: SUPABASE_SERVICE_ROLE_KEY tiene acceso completo a la base de datos.
# Nunca debe usarse en el frontend ni exponerse en el cliente.
# Solo para uso exclusivo en el backend (apps/api).
SUPABASE_SERVICE_ROLE_KEY=

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=
# En producción, GET /health/database devuelve 404 por defecto.
# Ponlo a "true" solo en entornos internos o con acceso controlado.
EXPOSE_DATABASE_HEALTH=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ISSUER=morer-api
JWT_AUDIENCE=morer-web
WEB_ORIGIN=https://morer.es
ADMIN_EMAIL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clave secreta de Stripe. SOLO backend (apps/api). NUNCA exponer al frontend ni al cliente.
# Test: sk_test_...   Producción: sk_live_...
# Requerida por PaymentsModule. Si falta, la API no arranca.
STRIPE_SECRET_KEY=

# Secret para verificar la firma HMAC de los webhooks de Stripe.
# SOLO backend (apps/api). NUNCA exponer al frontend.
# Obtener en local con: stripe listen --forward-to http://localhost:4000/payments/webhook/stripe
# En producción: Stripe Dashboard → Developers → Webhooks → tu endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec

# Clave pública de Stripe. Segura para el frontend (se puede exponer al cliente).
# Usada por Stripe Elements en Fase 9B (apps/web). Test: pk_test_...   Producción: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=
RESEND_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
